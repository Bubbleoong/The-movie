[TEMPLATE]
# Server-only: Supabase Postgres connection string
DATABASE_URL=
# Optional (serverless e.g. Vercel): contents of supabase/ca.crt — local/Node hosts read the file instead
DATABASE_CA_CERT=
# Public (bundled into frontend): Supabase project URL and publishable key
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public website origin: used for recovery email links and allowed API Origin.
# Production: https://your-domain.vercel.app (no path); local: http://localhost:5173
APP_ORIGIN=
