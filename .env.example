[TEMPLATE]
# Server-only: Supabase Postgres connection string
DATABASE_URL=
# Optional (serverless e.g. Vercel): contents of supabase/ca.crt — local/Node hosts read the file instead
DATABASE_CA_CERT=
# Public (bundled into frontend): Supabase project URL and publishable key
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Production: allowed Origin for state-changing API requests, e.g. https://your-domain.vercel.app
APP_ORIGIN=
